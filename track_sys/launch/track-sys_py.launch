<launch>

  <node
    pkg="track_sys"
    type="camera_node"
    name="camera_node"
    output="screen"
  >
    <param name="camera_info_url"
               value="file://$(find track_sys)/config/camera_calibration.yaml"/>
  </node>

  <node 
    pkg="image_proc"
    type="image_proc"
    name="image_proc"
    output="screen"
  />

  <!--
  <node
    pkg="track_sys"
    type="detector_node.py"
    name="detector_node"
    output="screen"
  /> -->

  <node
  pkg="track_sys"
  type="cropper_node"
  name="cropper_node"
  output="screen" >

    <rosparam file="$(find track_sys)/config/config_cropper.yaml"/>

  </node>

  <node 
    pkg= "track_sys"
    type="tracker_node"
    name="tracker_node"
    output="screen"> 
    </node>

</launch>